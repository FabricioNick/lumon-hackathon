VITE_API_BASE_URL=
VITE_WS_BASE_URL=
# Optional CI override; otherwise production builds read git rev-parse --short=7 HEAD.
VITE_BUILD_SHA=
# CP1 owns the authenticated HTTP client and SSE service.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
# Optional storage provider already registered and verified by the team.
VITE_STORAGE_PROVIDER=
# SUPABASE: only a publishable/anon key, never a secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLIC_KEY=
# CLOUDINARY: unsigned preset, never an API secret. Exact upload endpoint from provider.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_UPLOAD_URL=
